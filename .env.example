# Supabase Project Configuration
# Replace with your actual Supabase project URL and anon public key from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-actual-anon-key-here

# Save screening protocol results to the screening_results table (set false only if you want to skip screening table)
VITE_SAVE_SCREENING=true
